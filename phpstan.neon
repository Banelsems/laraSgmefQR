parameters:
    level: 8
    paths:
        - src

    excludePaths:
        - src/Tests/*
        - src/database/migrations/*

    ignoreErrors:
        - '#Call to an undefined method Illuminate\\.*#'
        - '#Call to an undefined static method Banelsems\\LaraSgmefQr\\DTOs\\(InvoiceType|PaymentType)Dto::collection\(\)#'
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
